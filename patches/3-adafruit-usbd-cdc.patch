+// karabas: the USB irq (usb_task_irq in ports/rp2040) runs tud_task() unless __usb_mutex is
+// taken. A read / write / flush from a task claims the endpoint with TinyUSB's own (sleeping)
+// mutex; an irq that runs tud_task() then and claims it too waits forever for the task it
+// interrupted, and core0 stops. So the task side takes __usb_mutex. When it is taken already,
+// this runs inside tud_task() (a callback), where the irq cannot get in anyway.
+#ifdef ARDUINO_ARCH_RP2040
+#include "pico/mutex.h"
+extern mutex_t __usb_mutex;
+#define USB_TASK_LOCK() bool usb_locked_ = mutex_try_enter(&__usb_mutex, NULL)
+#define USB_TASK_UNLOCK() do { if (usb_locked_) mutex_exit(&__usb_mutex); } while (0)
+#else
+#define USB_TASK_LOCK() do {} while (0)
+#define USB_TASK_UNLOCK() do {} while (0)
+#endif
+
 // SerialTinyUSB can be macro expanding to "Serial" on supported cores
 Adafruit_USBD_CDC SerialTinyUSB;
 
