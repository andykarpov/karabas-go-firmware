+// karabas: tud_task() runs in the USBD task (src/usb/usb_device.cpp) under __usb_mutex, and so
+// does the task side. TinyUSB's own pico mutexes belong to a core, not a task, and a wait for
+// one is a wfe loop: USBD (above APP) waiting for an endpoint that APP claimed would never let
+// APP run again. When the mutex is taken already, this runs inside tud_task() (a callback) or
+// USBD is blocked in an MSC callback; the call then goes without it.
+#ifdef ARDUINO_ARCH_RP2040
+#include "pico/mutex.h"
+extern mutex_t __usb_mutex;
+#define USB_TASK_LOCK() bool usb_locked_ = mutex_try_enter(&__usb_mutex, NULL)
+#define USB_TASK_UNLOCK() do { if (usb_locked_) mutex_exit(&__usb_mutex); } while (0)
+#else
+#define USB_TASK_LOCK() do {} while (0)
+#define USB_TASK_UNLOCK() do {} while (0)
+#endif
+
 // SerialTinyUSB can be macro expanding to "Serial" on supported cores
 Adafruit_USBD_CDC SerialTinyUSB;
 
